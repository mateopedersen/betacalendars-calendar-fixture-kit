<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>BetaCalendars.CalendarFixtureKit</PackageId>
    <Version>0.1.0</Version>
    <Authors>Beta Calendars</Authors>
    <Description>Deterministic .NET calendar fixtures, month-grid validation, regression diffs, and DateOnly test helpers.</Description>
    <PackageProjectUrl>https://www.betacalendars.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mateopedersen/betacalendars-calendar-fixture-kit.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>calendar;dateonly;testing;fixtures;regression;month-grid</PackageTags>
    <PackageReleaseNotes>First release: deterministic month and blank-grid fixtures, invariant diagnostics, structured diffs, and JSON snapshots.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <None Include="../../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../icon.png" Pack="true" PackagePath="/icon.png" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
